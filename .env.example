# Copia este archivo como .env SOLO en tu equipo (nunca lo subas a Git).
# Valores ficticios: reemplázalos por los de una base Upstash de PRUEBAS.
# Sin estas dos variables, el modo local usa memoria + SSE.
UPSTASH_REDIS_REST_URL=https://ejemplo-ficticio.upstash.io
UPSTASH_REDIS_REST_TOKEN=token-ficticio-no-usar
# Prefijo distinto por entorno (desarrollo, pruebas, preview, producción).
REDIS_KEY_PREFIX=farsante:dev

# Servidor local
PORT=3000
# 127.0.0.1 por defecto; 0.0.0.0 para probar desde el móvil en la red local.
HOST=127.0.0.1
# poll fuerza consultas periódicas como en Vercel; por defecto SSE con memoria.
# SYNC_MODE=poll

# Sal para el hash de IP en la limitación de solicitudes (servidor). Valor ficticio.
RATE_LIMIT_SALT=cambia-esta-sal-ficticia
# SOLO desarrollo y pruebas locales: multiplica los límites (por defecto 1).
# RATE_LIMIT_MULTIPLIER=100
